# Supabase — required. Get these from your Supabase project settings > API.
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_URL="https://your-project-ref.supabase.co"

# Same values, exposed to the client bundle by Vite (must start with VITE_).
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Optional — used only by src/integrations/supabase/client.server.ts for
# trusted server-side/admin operations that must bypass RLS. Never expose
# this to the client. Not required to run the app day-to-day.
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional — canonical site URL used for SEO tags and WhatsApp share links.
VITE_SITE_URL="https://loyeralert.bf"
